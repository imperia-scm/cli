{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/imperia-cli/imperia-cli/schemas/imperia-cli.config.schema.json",
  "title": "imperia-cli Workspace Config",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "workspace": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Display name for the workspace in the CLI UI."
        }
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "runSelectionPath": {
          "type": "string",
          "minLength": 1,
          "description": "Optional path where the run selection state is persisted."
        }
      }
    },
    "repositories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/repository"
      }
    },
    "services": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/service"
      }
    }
  },
  "required": [
    "repositories"
  ],
  "$defs": {
    "stringRecord": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "boolean"
        ]
      }
    },
    "repository": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "root": {
          "type": "string",
          "minLength": 1,
          "description": "Absolute path or template path such as ${workspaceFolder}/repo."
        },
        "solutionPath": {
          "type": "string",
          "minLength": 1,
          "description": "Absolute path or template path to the .sln file."
        },
        "existenceLabel": {
          "type": "string"
        },
        "buildStateFileName": {
          "type": "string",
          "minLength": 1
        },
        "buildTaskLabel": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "key",
        "root",
        "solutionPath"
      ]
    },
    "preflightNpmAuth": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "type": {
          "const": "npm-auth"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "cwd": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "type"
      ]
    },
    "preflightCommand": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "type": {
          "type": "string"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "command": {
          "type": "string",
          "minLength": 1
        },
        "args": {
          "type": "array",
          "items": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          }
        },
        "cwd": {
          "type": "string",
          "minLength": 1
        },
        "env": {
          "$ref": "#/$defs/stringRecord"
        }
      },
      "required": [
        "command"
      ]
    },
    "service": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "commandName": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "repoKey": {
          "type": "string",
          "minLength": 1
        },
        "runtime": {
          "type": "string",
          "minLength": 1
        },
        "ports": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          }
        },
        "cwd": {
          "type": "string",
          "minLength": 1
        },
        "env": {
          "$ref": "#/$defs/stringRecord"
        },
        "command": {
          "type": "string",
          "minLength": 1
        },
        "args": {
          "type": "array",
          "items": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          }
        },
        "preflightTitle": {
          "type": "string",
          "minLength": 1
        },
        "preflight": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/preflightNpmAuth"
              },
              {
                "$ref": "#/$defs/preflightCommand"
              }
            ]
          }
        }
      },
      "required": [
        "commandName",
        "repoKey",
        "command"
      ]
    }
  }
}
